# Copy to .env (next to main.py, or next to Naretta.exe) only if you prefer an
# environment variable over the key saved in Settings. A key saved in Settings
# (Windows Credential Manager) takes priority. Never commit your real .env.
OPENAI_API_KEY=sk-your-api-key-here

# Optional overrides
# NARETTA_MODEL=gpt-realtime-2.1
# NARETTA_TRANSCRIBE_MODEL=gpt-4o-transcribe
# NARETTA_DEBUG=1
